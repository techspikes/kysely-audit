{
  "name": "@techspikes/kysely-audit",
  "version": "0.1.0",
  "description": "Read-scope audit logging for Kysely",
  "author": "knzbr <87257088+knzbr@users.noreply.github.com>",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "scripts": {
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config --fix .",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc && c8 node --test --test-isolation=none test/*.test.ts",
    "benchmark": "tsc && node --test --test-isolation=none test/benchmark/benchmark.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@types/node": "26.6.6",
    "c8": "10.1.3",
    "eslint": "^10.0.0",
    "kysely": "0.29.9",
    "neostandard": "^0.14.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "kysely": ">=0.29.8 <0.30.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "overrides": {
    "test-exclude": {
      "glob": {
        ".": "^14.0.6",
        "minimatch": "^11.0.1"
      },
      "minimatch": "^11.0.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techspikes/kysely-audit.git"
  },
  "bugs": {
    "url": "https://github.com/techspikes/kysely-audit/issues"
  },
  "homepage": "https://github.com/techspikes/kysely-audit#readme",
  "keywords": [
    "kysely",
    "audit",
    "database",
    "logging"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^24.22.3 || ^26.13.1",
    "npm": ">=10.9.3"
  }
}
