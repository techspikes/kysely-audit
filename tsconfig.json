{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "types": ["node"],
    "lib": ["ES2024"],
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "eslint.config.ts"
  ]
}
